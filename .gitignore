# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# --- ProjectNR additions ---------------------------------------------------

# Newer Visual Studio solution format, generated like *.sln
*.slnx

# Local backups of the project file and configs
*.bak

# Local tool configuration (MCP servers on this machine)
.mcp.json

# Obsidian vault kept alongside the project - not part of the repository
/ProjectNR/

# Content: only assets made for this project are tracked. Everything else comes from
# marketplace / sample packs whose licenses do not allow redistributing the raw assets;
# README.md lists them and the changes made to them.
/Content/*
!/Content/Blueprints/
/Content/Blueprints/*
!/Content/Blueprints/Player/
!/Content/StateTree/
!/Content/DataAssets/
